.DS_Store
.env
.env.*
!.env.example

# Release signing keys — never commit
/keys/

# Agent skills installed locally (npx skills add), not part of the app
/.agents/
/.claude/
/skills-lock.json

# --- Logs ---
# Runtime logs generated by Deskemy (tracing). Never commit; they're recreated
# on every launch beside the executable / in the working directory.
*.log
*.err
deskemy.log
deskemy.err.log

# --- Build artifacts ---
# Cargo build output. Each crate already ignores its own /target/, but guard
# the root too in case stray builds land here.
/target/
**/target/

# --- OS / editor / IDE cruft ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- Packaged releases & local installers ---
# cargo-packager output (app/target/packages), snapshot PNGs, QA courses, etc.
*.exe
*.msi
*.msu
*.msm
*.msp
*.appx
*.appxbundle
*.msix
*.msixbundle
*.appinstaller
*.deb
*.rpm
*.AppImage
*.tar.gz
*.zip
*.7z

# Snapshot / smoke-test output
*.png
!app/ui/logo.png
!app-icon.png
!Images/**/*.png

# --- Local vendor binaries (too large for git) ---
# app/vendor/ already ignored at app-level; add a root guard.
/vendor/
/app/vendor/

# --- Misc generated / local state ---
*.pid
*.seed
*.pid.lock
*.local

